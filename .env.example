# Copy this file to .env and fill in values for local development
# Never commit .env to git

# API server settings
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Streamlit — where to find the FastAPI backend
FASTAPI_BASE_URL=http://localhost:8000

# MLflow tracking
MLFLOW_TRACKING_URI=./mlruns
MLFLOW_EXPERIMENT_NAME=credit-risk-prediction

# Logging
LOG_LEVEL=INFO
